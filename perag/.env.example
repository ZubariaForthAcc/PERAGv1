# Copy this file to .env and fill in the keys for whichever cloud backends
# you plan to use. This file is read by the `backend` container only — keys
# never reach the browser. Leave a variable blank/unset to disable that
# backend (PERAG will show "[No <backend> API key configured...]" instead
# of failing silently).

# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# https://console.groq.com/ (has a free tier)
GROQ_API_KEY=

# https://platform.openai.com/
OPENAI_API_KEY=

# https://openrouter.ai/ (has free models)
OPENROUTER_API_KEY=

# Optional: only needed if Ollama isn't reachable at the default
# http://host.docker.internal:11434 from inside the backend container.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
